@page "/upload"
@using Argus.Sdk
@using System.IO
@using Argus.FrontEnd.Services
@inject ArgusApiClient ApiClient
@inject NavigationManager Nav
@inject IFilePickerService FilePickerService

<div class="page-header mb-5">
    <h2 class="mb-1">Upload project</h2>
    <p class="text-muted">Upload a ZIP archive to scan for secrets and generate an SBOM.</p>
</div>

<div class="upload-card">
    @if (isLoading)
    {
        <div class="upload-loading">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 mb-1 fw-medium">Uploading project…</p>
            <p class="text-muted small">This may take a moment</p>
        </div>
    }
    else
    {
        <form @onsubmit="HandleUploadProject">

            <div class="mb-4">
                <label class="form-label" for="projectName">Project name</label>
                <input type="text"
                       id="projectName"
                       class="form-control"
                       @bind="projectName"
                       placeholder="e.g. MyWebApp"
                       maxlength="100"
                       disabled="@isLoading" />
            </div>

            <div class="mb-4">
                <label class="form-label" for="zipFile">
                    ZIP file <span class="text-muted fw-normal">(max 200 MB)</span>
                </label>
                <div class="upload-dropzone @(selectedFile != null ? "upload-dropzone--selected" : "")" @onclick="HandleSelectFile" style="cursor: pointer;">
                    @if (selectedFile != null)
                    {
                        <div class="upload-file-info">
                            <span class="upload-file-icon">📦</span>
                            <div>
                                <div class="fw-medium small">@selectedFileName</div>
                                <div class="text-muted small">@FormatFileSize(selectedFileSize)</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="upload-placeholder">
                            <span class="upload-placeholder-icon">⬆</span>
                            <span class="small text-muted">Click to select a <code>.zip</code> file</span>
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mb-4">@errorMessage</div>
            }

            <button type="submit"
                    class="btn btn-primary w-100"
                    disabled="@(selectedFile == null || string.IsNullOrWhiteSpace(projectName) || isLoading)">
                Upload &amp; scan
            </button>

        </form>
    }
</div>

@code {
    private const long MaxFileSize = 200 * 1024 * 1024;

    private string          projectName      = string.Empty;
    private byte[]?         selectedFile;
    private string          selectedFileName = string.Empty;
    private long            selectedFileSize;
    private bool            isLoading;
    private string          errorMessage     = string.Empty;
    private Guid            uploadedProjectId;

    private async Task HandleSelectFile()
    {
        if (isLoading)
            return;

        errorMessage      = string.Empty;
        uploadedProjectId = Guid.Empty;

        var result = await FilePickerService.PickFileAsync();

        if (result == null)
        {
            // User cancelled
            return;
        }

        if (result.FileSize > MaxFileSize)
        {
            errorMessage = $"File is too large. Maximum is 200 MB (yours: {FormatFileSize(result.FileSize)}).";
            selectedFile = null;
            return;
        }

        selectedFile     = result.FileBytes;
        selectedFileName = result.FileName;
        selectedFileSize = result.FileSize;
    }

    private async Task HandleUploadProject()
    {
        if (selectedFile is null || string.IsNullOrWhiteSpace(projectName))
            return;

        try
        {
            isLoading    = true;
            errorMessage = string.Empty;

            var result = await ApiClient.UploadProjectAsync(projectName.Trim(), selectedFile, selectedFileName);
            Nav.NavigateTo($"projects/{result.ProjectId}/scans");
        }
        catch (Exception ex)
        {
            errorMessage = $"Upload failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetForm()
    {
        projectName       = string.Empty;
        selectedFile      = null;
        selectedFileName  = string.Empty;
        selectedFileSize  = 0;
        errorMessage      = string.Empty;
        uploadedProjectId = Guid.Empty;
    }

    private static string FormatFileSize(long bytes) => bytes switch
    {
        < 1024        => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _             => $"{bytes / (1024.0 * 1024):F1} MB"
    };
}
